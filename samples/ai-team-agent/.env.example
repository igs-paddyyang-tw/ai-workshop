# ── Telegram Bot（必填）──────────────────────────────────────
# 🔴 每位學員必須用**自己**的 token。同一 token 兩處 polling 會隨機吃訊息且不報錯。
TELEGRAM_BOT_TOKEN=your_token

# ── LLM（agent 走 CLI backend；有 key 才啟用 API 對話）────────
GEMINI_API_KEY=your_key

# ── 選配 ─────────────────────────────────────────────────────
# TEAM_AGENT_PORT=23050          # 不設就讀 team.yaml 的 health_port
