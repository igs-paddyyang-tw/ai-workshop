{
  "enabled": true,
  "name": "Check New Imports",
  "description": "Python 檔案被編輯時檢查第三方 import 是否列在 requirements.txt",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "檢查這個 Python 檔案的 import 語句，確認所有第三方套件都已列在 requirements.txt 中。如果發現有新的第三方套件未列入，提醒使用者需要加入 requirements.txt。忽略標準庫和專案內部模組（src.*、business.*、coordinator.*、runtime.*、gateway.*）。"
  }
}
