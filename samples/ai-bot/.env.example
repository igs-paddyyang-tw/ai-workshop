# ── Telegram Bot（必填）──────────────────────────────────────
# 🔴 每位學員必須用**自己**的 token。
#    同一個 token 在兩個地方 polling 會**隨機**吃掉對方的訊息，而且不報錯。
TELEGRAM_BOT_TOKEN=your_token

# ── LLM（chat 模式用；agent 模式走 CLI backend，零 API 費用）──
GEMINI_API_KEY=your_key

# ── 選配 ─────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_key
# TELEGRAM_CHAT_ID=your_chat_id      # 排程推播目標
