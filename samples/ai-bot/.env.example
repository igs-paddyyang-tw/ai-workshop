# ═══════════════════════════════════════
# 個體 Agent 環境變數
# ═══════════════════════════════════════

# [必填] Telegram Bot Token
# 取得方式：Telegram 搜尋 @BotFather → /newbot → 複製 Token
TELEGRAM_BOT_TOKEN=

# [必填] Google Gemini API Key
# 取得方式：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ═══════════════════════════════════════
# LLM Provider 設定（全域，Bot 啟動時讀取）
# ═══════════════════════════════════════

# 預設 Provider（gemini / openai / anthropic）
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7

# [選填] OpenAI（切換 LLM_PROVIDER=openai 時需要）
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# [選填] Anthropic（切換 LLM_PROVIDER=anthropic 時需要）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4

# [選填] Agent 分身 CLI 後端（kiro / gemini / claude）
# AGENT_CLI_BACKEND=kiro

# [選填] 伺服器設定
# HOST=0.0.0.0
# PORT=8000

# [選填] Log 等級（DEBUG / INFO / WARNING）
# LOG_LEVEL=DEBUG

# ═══════════════════════════════════════
# 團隊模式（有 team.yaml 時啟用）
# ═══════════════════════════════════════

# [選填] A2A 認證 token（跨機協作時，雙方設同一個值）
# 未設定 = 開發模式（不驗證）
# A2A_SECRET=your-shared-secret-here

# [選填] 遠端 Agent Token（對應 team.yaml 的 auth_token_env）
# CODER_AGENT_TOKEN=remote-coder-token
# QA_AGENT_TOKEN=remote-qa-token

# [選填] 本機 Agent 名稱（用於 Agent Card）
# AGENT_NAME=ai-bot
