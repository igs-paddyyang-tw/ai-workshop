# ═══ 必要 ═══
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# ═══ Ark Agent（Gemini ReAct 主路由）═══
# LLM_PROVIDER=gemini                   # gemini / openai / anthropic
# LLM_MODEL=gemini-3.5-flash            # Ark Agent 用的模型（意圖判斷 + 簡單問答）
# LLM_TEMPERATURE=0.7

# ═══ Agent 分身（CLI 執行深度任務）═══
# CLI_BACKEND=agy                        # agy / kiro / claude
# CLI_MODEL=claude-sonnet-4-6            # Agent 分身用的模型（寫程式、分析、報告）

# ═══ 伺服器 ═══
# PORT=8080                              # FastAPI Web UI + REST API

# ═══ 存取控制 ═══
# ADMIN_CHAT_IDS=123456,789012           # TG 白名單（逗號分隔）

# ═══ 除錯 ═══
# LOG_LEVEL=INFO
