# ═══════════════════════════════════════════════════
# ai-bot 環境變數範本
# 複製為 .env 並填入實際值
# ═══════════════════════════════════════════════════

# ── Step 2：Telegram Bot ──────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Step 4：LLM CLI ──────────────────────────────
# Gemini CLI 使用 Gmail 登入，不需要 API Key
# 以下為選配（如使用 API 模式或其他後端）
# GEMINI_API_KEY=your_gemini_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ── CLI 路徑覆寫（選填，通常不需要）────────────────
# GEMINI_CLI_CMD=gemini
# CLAUDE_CLI_CMD=claude
# AG_CLI_CMD=ag

# ── Step 5：排程設定 ─────────────────────────────
NEWS_SCHEDULE_CRON=0 9 * * *
NEWS_TIMEZONE=Asia/Taipei

# ── 通用 ─────────────────────────────────────────
LOG_LEVEL=INFO
