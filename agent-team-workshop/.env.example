# ═══════════════════════════════════════════════════
# Agent Team 環境變數範本
# 複製為 .env 並填入實際值
# ═══════════════════════════════════════════════════

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ── Kiro CLI 路徑（選填，通常自動偵測）──────────────
# Windows 預設：C:\Users\{你的帳號}\AppData\Local\Kiro-Cli\kiro-cli.exe
# 如果 start.py 找不到 kiro-cli，手動填入絕對路徑
# KIRO_CLI_PATH=C:\Users\paddyyang\AppData\Local\Kiro-Cli\kiro-cli.exe

# ── 工作目錄（選填）────────────────────────────────
# ARK_TEAM_AGENT_HOME=D:\my-team

# ── 通用 ─────────────────────────────────────────
LOG_LEVEL=INFO
