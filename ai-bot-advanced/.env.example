# ═══════════════════════════════════════════════════
# ai-bot（進階班）環境變數範本
# 複製為 .env 並填入實際值
# ═══════════════════════════════════════════════════

# ── Telegram Bot ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Gemini API ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── 排程設定 ─────────────────────────────────────
NEWS_SCHEDULE_CRON=0 9 * * *
NEWS_TIMEZONE=Asia/Taipei

# ── 通用 ─────────────────────────────────────────
LOG_LEVEL=INFO
